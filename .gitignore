# Project specific
# Data directories
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Models - ignore all trained models but keep directory structure
models/*
!models/.gitkeep
!models/__init__.py


# Results - nothing here is tracked. See results/PROVENANCE.md for the rule:
# an artifact may be committed only if a command on main regenerates it, with
# its config and seed committed alongside.
#
# The old rules ignored results/*.csv, which does not match subdirectories - that
# is how results/tables/paper-results.csv became tracked and fed a public claim
# nothing could reproduce. Figures were whitelisted "for README" and were
# generated from hardcoded literals. Both holes are closed; keep them closed.
results/**
!results/**/
!results/PROVENANCE.md
!results/**/.gitkeep

# MLFlow
mlruns/

# Serialized models and data
*.pkl
*.joblib
*.h5
*.pth
*.pt

# Logs
*.log
logs/

